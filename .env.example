# Copy to .env.local and fill in.

# Local MongoDB, or an Atlas connection string:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=portfolio

# Signs the admin session cookie. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# scrypt hash of your admin password, as `salt:hash`.
# Generate with: npm run set-password -- "your password"
ADMIN_PASSWORD_HASH=
